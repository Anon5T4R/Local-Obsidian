# PKGBUILD do Local Notebook para Arch (uso pessoal do Joao; nao publicado no AUR).
# Instala a arvore FHS (bin/ + share/) do tarball da release - o mesmo artefato
# que o package.sh gera. O sha256 fica SKIP no repo (o hash so existe apos a
# release); o job arch do CI substitui pelo real ao construir o pacote.
#
#   makepkg -si   (local, com o tarball da release ao lado)

pkgname=com.localobsidian.app
pkgver=0.1.0
pkgrel=1
pkgdesc='Notas, wikilinks e anexos numa pasta comum, 100% offline (Rust + egui)'
arch=(x86_64)
url='https://github.com/Anon5T4R/Local-Obsidian'
license=('MIT OR Apache-2.0')
provides=('localobsidian')
conflicts=('localobsidian')
depends=(glibc gcc-libs libxcb libxrandr libxi libxcursor libxkbcommon)
optdepends=('xdg-desktop-portal: seletor nativo de arquivos (GNOME/KDE ja trazem)')
options=(!debug)
source=("localobsidian-$pkgver-linux-x86_64.tar.gz")
sha256sums=('SKIP')

package() {
  cd "$srcdir"
  install -dm755 "$pkgdir/usr"
  cp -a "localobsidian-$pkgver-linux-x86_64/bin" "$pkgdir/usr/"
  cp -a "localobsidian-$pkgver-linux-x86_64/share" "$pkgdir/usr/"
}
